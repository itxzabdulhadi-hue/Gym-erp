# ---------------------------------------------------------------------------
# Platform configuration (server side ONLY - never exposed to the browser)
# Copy to .env and fill in real values.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Neon (recommended):  postgresql://user:pass@ep-xyz-pooler.region.aws.neon.tech/neondb?sslmode=require
# Local PGlite dev server (npm run db:up): postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
# auto | true | false.
#   auto  - TLS unless DATABASE_URL says sslmode=disable or points at localhost
#           (the right choice for both Neon and local development)
#   true  - force TLS, accepting the provider's certificate
#   false - plain TCP, local development only
DATABASE_SSL=auto
# Connections per server instance. Serverless deployments should stay low
# (1-3) and rely on Neon's pooler; a long-lived container can use 10-20.
DATABASE_POOL_MAX=10

# Comma separated list of hosts allowed to call the API (CORS).
# Leave empty to only allow same-origin requests.
CORS_ORIGINS=http://localhost:5173
# Set to 1 behind a proxy that terminates TLS (Vercel, nginx, a load balancer)
# so Express reads X-Forwarded-* and marks cookies secure correctly.
TRUST_PROXY=0

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Both are required (minimum 16 characters) - there is no development fallback,
# so a missing secret stops the server at boot rather than signing with a guess.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
# Password reset tokens are random 32-byte values stored as SHA-256 hashes with
# a one hour expiry, so they need no signing secret of their own.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Stricter limit for login, register, password reset and token refresh.
AUTH_RATE_LIMIT_MAX=20

# --- File storage ---------------------------------------------------------
# local  -> ./storage/uploads (development only; ephemeral on Vercel)
# s3     -> any S3 compatible bucket (AWS S3, Cloudflare R2, MinIO, Wasabi)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_BASE_URL=
# Required when STORAGE_DRIVER=s3 (install @aws-sdk/client-s3 first)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Serving the web bundle ----------------------------------------------
# When true the Express process also serves the built SPA, so a single Node
# server (Docker, a VPS) can host the whole product. On Vercel leave this off:
# vercel.json serves web/dist statically and routes /api to the function.
SERVE_WEB_DIST=false
WEB_DIST_DIR=./web/dist

# --- Demo / seeding -------------------------------------------------------
DEMO_TENANT_SLUG=demo-gym
SEED_OWNER_EMAIL=owner@demogym.test
SEED_OWNER_PASSWORD=Demo1234!

# --- Outbound channels: NOT WIRED YET ------------------------------------
# Placeholder keys for the provider-agnostic notification ports. Nothing reads
# these today - the only working channel is in-app, and any other channel
# returns NOT_CONFIGURED from POST /api/notifications/test. Kept here so the
# eventual SMTP/Twilio adapters have a defined place to read from.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
